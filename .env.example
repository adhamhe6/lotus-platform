# ── Lotus Platform configuration ──────────────────────────────────────────────────────────
# Copy to `.env` and fill in the REQUIRED values. Nothing here is ever baked into an image.

# REQUIRED. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# REQUIRED. Password for the bundled PostgreSQL user.
POSTGRES_PASSWORD=
POSTGRES_USER=lotus
POSTGRES_DB=lotus

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
# Public origin(s) the browser uses (comma-separated). Only these may call the API cross-origin.
CORS_ORIGINS=http://localhost:8080
# Set true when serving over HTTPS (refresh-token cookie gets the Secure flag).
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=50

# ── AI (optional) ──────────────────────────────────────────────────────────────────────────
# deterministic = no model; rule-based narration of computed evidence; nothing leaves the server.
# openai_compatible = OpenAI, Ollama, vLLM, LM Studio, OpenRouter…   anthropic = Anthropic Messages API
AI_PROVIDER=deterministic
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Local, self-hosted example (docker compose --profile ollama up):
#   AI_PROVIDER=openai_compatible  AI_BASE_URL=http://ollama:11434/v1  AI_MODEL=llama3.1:8b
# Embeddings: tfidf-lsa (offline default) | sentence-transformers (needs the `nlp` extra and model access)
EMBEDDING_PROVIDER=tfidf-lsa

# ── Demo workspace ─────────────────────────────────────────────────────────────────────────
# SEED_DEMO_DATA=true creates demo@lotus-demo.org with the sample projects on first start (needs a password).
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=
